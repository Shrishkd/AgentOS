# Use immutable release tags or registry digests.
AGENTOS_BACKEND_IMAGE=agentos-backend:release-1
AGENTOS_DASHBOARD_IMAGE=agentos-dashboard:release-1
AGENTOS_SECRET_DIR=/etc/agentos/secrets
AGENTOS_TOKEN_ISSUER=https://identity.example.org/
AGENTOS_TOKEN_AUDIENCE=agentos-api
AGENTOS_BACKUP_VOLUME=agentos-production-base-backups
AGENTOS_WAL_VOLUME=agentos-production-wal
AGENTOS_BIND_ADDRESS=127.0.0.1
AGENTOS_HTTPS_PORT=8443
AGENTOS_API_PROCESSES=3
